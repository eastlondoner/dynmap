modules = ["java-graalvm25.0", "nodejs-20", "php-8.2", "web", "python-3.11"]
[agent]
expertMode = true

[nix]
channel = "unstable"
packages = ["jdk21", "gradle"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Dynmap Download Portal"

[[workflows.workflow]]
name = "Dynmap Download Portal"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 server.py"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
build = ["sh", "-c", "./gradlew :spigot:build :fabric-1.21.6:build :forge-1.21.6:build && cp target/* public/downloads"]
deploymentTarget = "static"
publicDir = "public"
